    "force": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "softer .. harder (0.5 = a natural soft step; 1 = as hard as a stomp). ",
      "map": [
        {
          "to": "0.force",
          "op": "set",
          "points": [
            [
              0.0,
              -1.8
            ],
            [
              0.5,
              -1.0
            ],
            [
              1.0,
              1.0
            ]
          ],
          "clamp": [
            -3,
            3
          ]
        }
      ],
      "label": "Intensity"
    },
    "soft": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "sharper .. softer attack (a gentler transient and less heel / thump).",
