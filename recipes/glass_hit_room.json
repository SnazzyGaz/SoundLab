{
  "soundlab": 1, "name": "Glass rod tapped with a hard hammer, small room (chain example)",
  "sample_rate": 48000, "duration": 3.0, "seed": 2,
  "layers": [
    {"name": "tap", "chain": [
      {"model": "impact", "params": {"velocity": 1.2, "contact_ms": 0.2, "bounces": 3, "restitution": 0.4, "first_gap": 0.08}},
      {"model": "modal", "params": {"material": "glass", "shape": "bar", "length": 0.25, "thickness": 0.008, "strike_pos": 0.1, "extra_damping": 1.5}},
      {"model": "radiation", "params": {"radius": 0.01}}
    ]}
  ],
  "post": [{"model": "room", "params": {"volume": 40, "absorption": 0.3, "source_distance": 1.0}}],
  "master": {"normalize_db": -1.0}
}
