{
  "soundlab": 1,
  "name": "A sword clash",
  "title": "Sword clash",
  "library": "Combat/Blades",
  "tags": [
    "sword",
    "blade",
    "metal"
  ],
  "category": "weapons",
  "sample_rate": 48000,
  "duration": 1.51,
  "seed": 1,
  "layers": [
    {
      "name": "stems",
      "model": "weapon_stems",
      "params": {
        "source": "sword_clash",
        "seed": 0,
        "at": 0.0,
        "force": 0.0,
        "soft": 0.0,
        "count": 1
