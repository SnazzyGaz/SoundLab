      "normalize": false,
      "gain_db": 3.0
    }
  ],
  "master": {
    "fade_out": 0.04,
    "normalize_db": null
  },
  "macros": {
    "force": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "softer .. harder (0.5 = the recording).",
      "map": [
        {
          "to": "0.force",
          "op": "set",
          "points": [
            [
              0.0,
              -1.5
            ],
            [
              0.5,
              0.0
            ],
            [
              1.0,
              1.0
            ]
          ],
          "clamp": [
            -3,
            3
          ]
        }
      ],
      "label": "Intensity"
    },
    "soft": {
      "default": 0.0,
      "jitter": 0.0,
      "doc": "sharper .. softer attack (a gentler transient and less heel / thump).",
      "map": [
        {
          "to": "0.soft",
          "op": "set",
          "points": [
            [
              0.0,
              0.0
            ],
            [
              0.5,
              0.0
            ],
            [
              1.0,
              1.1
            ]
          ],
          "clamp": [
            0,
            1.2
