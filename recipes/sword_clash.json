      "map": [
        {
          "to": "0.speed_cents",
          "op": "set",
          "points": [
            [
              0.0,
              300.0
            ],
            [
              0.5,
              0.0
            ],
            [
              1.0,
              -300.0
            ]
          ],
          "clamp": [
            -1200,
            1200
          ]
        }
      ],
      "label": "Size"
    },
    "distance": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "nearer .. further (0.5 = as recorded). Further is quieter and duller.",
      "map": [
        {
          "to": "0.distance",
          "op": "set",
          "points": [
            [
              0.0,
              0.7
            ],
            [
              0.5,
              1.0
            ],
            [
              1.0,
              2.0
            ]
          ],
          "clamp": [
            0.25,
            4.0
          ]
        }
      ],
      "label": "Distance"
    },
    "count": {
      "default": 0.0,
      "jitter": 0.0,
      "doc": "a short natural count of real gestures (1 .. 3).",
      "map": [
        {
          "to": "0.count",
          "op": "set",
          "points": [
            [
              0.0,
              1.0
            ],
            [
              0.5,
              2.0
            ],
            [
              1.0,
              3.0
            ]
          ],
          "clamp": [
            1,
            3
          ]
        }
      ],
      "label": "Count",
      "ui": "advanced"
    },
    "tempo": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "slower .. quicker spacing when count is more than one (0.5 = the recording's own gaps).",
      "map": [
        {
          "to": "0.tempo",
          "op": "set",
          "points": [
            [
              0.0,
              0.7
            ],
            [
              0.5,
              1.0
            ],
            [
              1.0,
              1.5
            ]
          ],
          "clamp": [
            0.4,
            2.5
          ]
        }
      ],
      "label": "Rate",
      "ui": "advanced"
    },
    "seed": {
      "default": 0.0,
      "jitter": 0.0,
      "doc": "another take: reseeds the noise and remixes the same real stems (never averaged).",
      "map": [
        {
          "to": "0.variation",
          "op": "set",
          "range": [
            0,
            1000
          ]
        }
      ],
      "label": "Seed",
      "ui": "hidden"
    },
    "object": {
      "default": "sword",
      "doc": "what clashes (kept so older calls still work; the stored source is unchanged).",
      "choices": {
        "sword": [],
        "pipe": [
