      "doc": "tap .. hard (mapped onto force; kept so older calls still work).",
      "map": [
        {
          "to": "0.force",
          "op": "add",
          "points": [
            [
              0.0,
              -0.8
            ],
            [
              0.5,
              0.0
            ],
            [
              1.0,
              0.8
            ]
          ],
          "clamp": [
            -3,
            3
          ]
        }
      ],
      "label": "Intensity",
      "ui": "hidden"
