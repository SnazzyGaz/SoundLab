            "to": "0.legacy_choice",
            "op": "set",
            "value": "pipe"
          }
        ],
        "plate": [
          {
            "to": "0.legacy_choice",
            "op": "set",
            "value": "plate"
          }
        ],
        "pan": [
          {
            "to": "0.legacy_choice",
            "op": "set",
            "value": "pan"
          }
        ]
      },
      "label": "Object",
      "ui": "hidden"
    },
    "intensity": {
      "default": 0.5,
