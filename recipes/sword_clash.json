    "scrape": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "clean clang .. long scrape (no longer used; kept so older calls still work).",
      "map": [
        {
          "to": "0.hs_hz",
          "op": "add",
          "points": [
            [
              0.0,
              0.0
            ],
            [
              1.0,
              0.0
            ]
          ]
        }
      ],
      "label": "Scrape",
      "ui": "hidden"
    },
    "ring": {
      "default": 0.5,
      "jitter": 0.0,
      "doc": "choked .. long ring (no longer used; kept so older calls still work).",
      "map": [
        {
          "to": "0.hs_hz",
          "op": "add",
          "points": [
            [
              0.0,
              0.0
            ],
            [
              1.0,
              0.0
            ]
